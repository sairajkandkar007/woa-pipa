;
; pipabt.inf - KTZ8866 backlight (Xiaomi Pad 6 / pipa), test driver
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %Mfg%
CatalogFile = pipabt.cat
DriverVer   = 11/20/2026,1.0.0.1
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %Disk%,,,""

[SourceDisksFiles]
pipabt.sys = 1,,

[Manufacturer]
%Mfg% = Std,NTARM64.10.0...16299

[Std.NTARM64.10.0...16299]
%Desc% = Bt_Inst, ACPI\QCOM2571

[Bt_Inst.NT]
CopyFiles = Bt_Files

[Bt_Files]
pipabt.sys


[Bt_Inst.NT.Services]
AddService = pipabt, 0x00000002, Bt_Svc

[Bt_Svc]
DisplayName   = %Desc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\pipabt.sys

[Bt_Inst.NT.Wdf]
KmdfService = pipabt, Bt_Wdf

[Bt_Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
Mfg  = "woa-pipa"
Disk = "pipabt install disk"
Desc = "QCA6390 Bluetooth probe (pipa)"
