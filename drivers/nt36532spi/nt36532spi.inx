;
; nt36532spi.inf - pipa touchscreen: own GENI SPI + NT36532, exposed as a HID touch screen.
; Stack: ACPI\QCOM250F PDO -> nt36532spi (lower filter, does the work) -> mshidkmdf (HID shim) -> hidclass
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Mfg%
CatalogFile = nt36532spi.cat
DriverVer   = 11/20/2026,1.0.0.2
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %Disk%,,,""

[SourceDisksFiles]
nt36532spi.sys = 1,,

[Manufacturer]
%Mfg% = Std,NTARM64.10.0...16299

[Std.NTARM64.10.0...16299]
%Desc% = Nt_Inst, ACPI\QCOM250F

[Nt_Inst.NT]
CopyFiles = Nt_Files

[Nt_Files]
nt36532spi.sys

[Nt_Inst.NT.HW]
AddReg = Nt_HW_AddReg

[Nt_HW_AddReg]
HKR,,"LowerFilters",0x00010000,"nt36532spi"

[Nt_Inst.NT.Services]
AddService = nt36532spi,, Nt_Svc
AddService = mshidkmdf, 0x00000002, Mshid_Svc

[Nt_Svc]
DisplayName   = %Desc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\nt36532spi.sys

[Mshid_Svc]
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\mshidkmdf.sys

[Nt_Inst.NT.Wdf]
KmdfService = nt36532spi, Nt_Wdf

[Nt_Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
Mfg  = "woa-pipa"
Disk = "nt36532spi install disk"
Desc = "pipa Touch Screen (NT36532)"
